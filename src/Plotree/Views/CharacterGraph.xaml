<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Plotree.Views.CharacterGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CharacterSelectionRingBrush" Color="White" />
        <Style x:Key="CharacterNodeStyle" TargetType="Button">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RelationshipLineStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style x:Key="RelationshipLabelStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <MenuFlyout x:Name="GroupsFlyout" ShouldConstrainToRootBounds="True" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar x:Name="GraphToolbar" DefaultLabelPosition="Right" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <AppBarButton x:Name="AddRelationshipButton" Icon="Add" Click="OnAddRelationship" AutomationProperties.AutomationId="AddRelationshipButton" />
            <AppBarSeparator />
            <AppBarButton x:Name="ZoomInButton" Icon="ZoomIn" Click="OnZoomIn" AutomationProperties.AutomationId="CharacterZoomInButton" />
            <AppBarButton x:Name="ZoomOutButton" Icon="ZoomOut" Click="OnZoomOut" AutomationProperties.AutomationId="CharacterZoomOutButton" />
            <AppBarButton x:Name="FitButton" Icon="FullScreen" Click="OnFit" AutomationProperties.AutomationId="CharacterFitButton" />
            <AppBarSeparator />
            <AppBarButton x:Name="GroupsButton" Icon="People" Click="OnGroupsClick" AutomationProperties.AutomationId="CharacterGroupsButton" />
            <AppBarButton x:Name="GroupVisibilityButton" Icon="View" AutomationProperties.AutomationId="CharacterGroupVisibilityButton">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="GroupVisibilityFlyout" Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True" />
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Viewport" Background="Transparent" SizeChanged="OnViewportSizeChanged">
                <ScrollViewer x:Name="GraphScroll" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4">
                    <Canvas x:Name="World" Background="Transparent" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" IsHitTestVisible="False" />
                <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False">
                    <Border x:Name="MarqueeVisual" Visibility="Collapsed" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="2">
                        <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                    </Border>
                </Canvas>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock x:Name="DetailsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock IsTextSelectionEnabled="True" x:Name="SelectedName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock IsTextSelectionEnabled="True" x:Name="SelectedGroups" TextWrapping="Wrap" />
                        <Image x:Name="SelectedAvatar" Width="96" Height="96" Stretch="UniformToFill" Visibility="Collapsed" />
                        <StackPanel x:Name="AvatarActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="ChangeAvatarButton" Click="OnChangeAvatar" AutomationProperties.AutomationId="ChangeCharacterAvatarButton" />
                            <Button x:Name="RemoveAvatarButton" Click="OnRemoveAvatar" AutomationProperties.AutomationId="RemoveCharacterAvatarButton" />
                        </StackPanel>
                        <TextBlock x:Name="RelationshipsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NoRelationshipsHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="RelationshipList" MaxHeight="250" SelectionMode="Single" SelectionChanged="OnRelationshipSelected" AutomationProperties.AutomationId="RelationshipList" />
                        <StackPanel x:Name="Editor" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="EditorHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="FirstCharacter" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnEditorSelectionChanged" AutomationProperties.AutomationId="RelationshipFirstCharacter" />
                            <ComboBox x:Name="SecondCharacter" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnEditorSelectionChanged" AutomationProperties.AutomationId="RelationshipSecondCharacter" />
                            <TextBox x:Name="RelationshipLabel" TextChanged="OnEditorTextChanged" AutomationProperties.AutomationId="RelationshipLabel" />
                            <TextBox x:Name="LabelBackgroundColor" TextChanged="OnEditorTextChanged" AutomationProperties.AutomationId="RelationshipLabelBackgroundColor" />
                            <TextBox x:Name="LabelForegroundColor" TextChanged="OnEditorTextChanged" AutomationProperties.AutomationId="RelationshipLabelForegroundColor" />
                            <TextBlock x:Name="ValidationMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RelationshipValidation" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveRelationshipButton" Click="OnSaveRelationship" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveRelationshipButton" />
                                <Button x:Name="DeleteRelationshipButton" Click="OnDeleteRelationship" AutomationProperties.AutomationId="DeleteRelationshipButton" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
